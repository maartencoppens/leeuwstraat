# Copy to .env.local for `npm run dev`. On Vercel, set these under Project > Settings > Environment Variables.

# Brevo > Settings > SMTP & API > API keys
BREVO_API_KEY=
# Brevo > Contacts > Lists: the number (ID) of the newsletter list
BREVO_LIST_ID=

# The campaign phase (0-4): how many story shards are unlocked. Change it on Vercel and redeploy.
# Leave it out to use DEFAULT_PHASE in config/phases.ts.
NEXT_PUBLIC_CURRENT_PHASE=1
